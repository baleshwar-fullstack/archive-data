{
  "name": "tiered-data-storage",
  "version": "1.0.0",
  "description": "AWS Lambda migration scheduler for weather_reports and project_hours tables",
  "main": "src/scripts/migrate-old-data.js",
  "scripts": {
    "migrate": "node src/scripts/migrate-old-data.js",
    "migrate:weather": "node src/scripts/migrate-old-data.js migrate weather_reports",
    "migrate:weather:dry": "node src/scripts/migrate-old-data.js migrate weather_reports --dry-run",
    "migrate:project_hours": "node src/scripts/migrate-old-data.js migrate project_hours",
    "migrate:project_hours:dry": "node src/scripts/migrate-old-data.js migrate project_hours --dry-run",
    "verify:weather": "node src/scripts/migrate-old-data.js verify weather_reports",
    "verify:project_hours": "node src/scripts/migrate-old-data.js verify project_hours",
    "migration:status": "node src/scripts/scheduled-migration.js status",
    "migration:enable": "node src/scripts/scheduled-migration.js enable",
    "migration:disable": "node src/scripts/scheduled-migration.js disable",
    "migration:logs": "node src/scripts/scheduled-migration.js logs",
    "test": "jest",
    "lambda:deploy": "serverless deploy",
    "lambda:deploy:dev": "serverless deploy --stage dev",
    "lambda:deploy:prod": "serverless deploy --stage prod",
    "lambda:remove": "serverless remove",
    "lambda:remove:dev": "serverless remove --stage dev",
    "lambda:remove:prod": "serverless remove --stage prod",
    "lambda:info": "serverless info",
    "lambda:info:dev": "serverless info --stage dev",
    "lambda:info:prod": "serverless info --stage prod",
        "lambda:logs": "serverless logs -f weatherReportsMigration --tail",
        "lambda:logs:dev": "serverless logs -f weatherReportsMigration --stage dev --tail",
        "lambda:logs:prod": "serverless logs -f weatherReportsMigration --stage prod --tail",
        "lambda:logs:weather": "serverless logs -f weatherReportsMigration --tail",
        "lambda:logs:weather:dev": "serverless logs -f weatherReportsMigration --stage dev --tail",
        "lambda:logs:weather:prod": "serverless logs -f weatherReportsMigration --stage prod --tail",
        "lambda:logs:project_hours": "serverless logs -f projectHoursMigration --tail",
        "lambda:logs:project_hours:dev": "serverless logs -f projectHoursMigration --stage dev --tail",
        "lambda:logs:project_hours:prod": "serverless logs -f projectHoursMigration --stage prod --tail",
        "lambda:migrate:weather": "serverless invoke -f weatherReportsMigration",
        "lambda:migrate:weather:dev": "serverless invoke -f weatherReportsMigration --stage dev",
        "lambda:migrate:weather:prod": "serverless invoke -f weatherReportsMigration --stage prod",
        "lambda:migrate:project_hours": "serverless invoke -f projectHoursMigration",
        "lambda:migrate:project_hours:dev": "serverless invoke -f projectHoursMigration --stage dev",
        "lambda:migrate:project_hours:prod": "serverless invoke -f projectHoursMigration --stage prod"
  },
  "dependencies": {
    "aws-sdk": "^2.1467.0",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "mysql2": "^3.6.0",
    "parquetjs": "^0.11.2",
    "serverless": "^3.35.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.2"
  },
  "keywords": [
    "aws-lambda",
    "mysql",
    "s3",
    "data-migration",
    "weather-reports",
    "project-hours"
  ],
  "author": "",
  "license": "MIT"
}
