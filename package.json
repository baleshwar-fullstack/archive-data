{
  "name": "tiered-data-storage",
  "version": "1.0.0",
  "description": "Node.js implementation of tiered data storage with MySQL and S3 Glacier",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node src/scripts/migrate-old-data.js",
    "migrate:weather": "node src/scripts/migrate-old-data.js migrate weather_reports",
    "migrate:weather:dry": "node src/scripts/migrate-old-data.js migrate weather_reports --dry-run",
    "verify:weather": "node src/scripts/migrate-old-data.js verify weather_reports",
    "migration:status": "node src/scripts/scheduled-migration.js status",
    "migration:enable": "node src/scripts/scheduled-migration.js enable",
    "migration:disable": "node src/scripts/scheduled-migration.js disable",
    "migration:trigger": "node src/scripts/scheduled-migration.js force",
    "migration:logs": "node src/scripts/scheduled-migration.js logs",
    "migration:cron": "node src/scripts/scheduled-migration.js cron",
    "test": "jest"
  },
  "dependencies": {
    "aws-sdk": "^2.1467.0",
    "axios": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "json2csv": "^6.0.0-alpha.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.6.0",
    "parquetjs": "^0.11.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "nodejs",
    "mysql",
    "s3",
    "glacier",
    "data-archiving"
  ],
  "author": "",
  "license": "MIT"
}
