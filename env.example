# Migration Scheduler Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-database-name

# AWS Configuration (Lambda will use IAM role, but you can override)
AWS_REGION=us-east-1
S3_BUCKET=your-archive-bucket
S3_ARCHIVE_PREFIX=archived-data/

# Athena Configuration
ATHENA_OUTPUT_BUCKET=your-archive-bucket
ATHENA_OUTPUT_PREFIX=temp-results/
ATHENA_DATABASE=archive_database
ATHENA_WORKGROUP=primary
ATHENA_IMMEDIATE_CLEANUP=true

# Migration Configuration
ARCHIVE_THRESHOLD_YEARS=2
MIGRATION_BATCH_SIZE=1000
SUPPORTED_TABLES=weather_reports,project_hours
LOG_LEVEL=info

# Lambda-specific settings
NODE_ENV=production
